# Vybrid also mirrors these keys to ~/.vybrid/.env so `vybrid` works from any directory.
# Place as `vybrid-rust/.env`, or use /menu (writes both locations). Optional: VYBRID_ROOT.

# Active LLM: groq (default), openrouter, or lmstudio
# VYBRID_LLM_PROVIDER=groq

# --- Groq (cloud) — default model openai/gpt-oss-120b (override with GROQ_MODEL if needed)
GROQ_API_KEY=your_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: after two OSS120B rate-limit waits, use this Groq model for the current response only.
# GROQ_RATE_LIMIT_FALLBACK_MODEL=qwen/qwen3-32b

# Sampling temperature 0.0–2.0 (default 0.3; low improves tool-call JSON reliability)
# VYBRID_TEMPERATURE=0.3
# GPT-OSS reasoning effort: low | medium | high (unset = provider default, medium).
# `low` cuts latency and reasoning tokens substantially in tool-heavy agent loops.
# VYBRID_REASONING_EFFORT=low
# Groq service tier: auto | on_demand | flex | performance (default auto)
# VYBRID_GROQ_SERVICE_TIER=auto
# Client-side TPM budget hints (defaults shown)
# VYBRID_GROQ_CONTEXT_TOKEN_BUDGET=36000
# VYBRID_GROQ_RETRY_CONTEXT_TOKEN_BUDGET=18000
# VYBRID_MAX_COMPLETION_TOKENS=4096
# VYBRID_GROQ_TPM_LIMIT=240000
# Tool rounds per turn before Vybrid asks whether to continue (default 48)
# VYBRID_MAX_TOOL_ROUNDS=48

# --- LM Studio (local OpenAI-compatible server) — set VYBRID_LLM_PROVIDER=lmstudio
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_API_KEY=lm-studio
# LM_STUDIO_MODEL=your-model-id-from-lm-studio

# --- OpenRouter (multi-provider cloud) — set VYBRID_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: SerpAPI for Google Search (google_search tool)
SERPAPI_KEY=your_serpapi_key_here
