# Vybrid also mirrors these keys to ~/.vybrid/.env so `vybrid` works from any directory.
# Place as `vybrid-rust/.env`, or use /menu (writes both locations). Optional: VYBRID_ROOT.

# Active LLM: groq (default) or lmstudio
# VYBRID_LLM_PROVIDER=groq

# --- Groq (cloud) — default model openai/gpt-oss-120b (override with GROQ_MODEL if needed)
GROQ_API_KEY=your_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# --- LM Studio (local OpenAI-compatible server) — set VYBRID_LLM_PROVIDER=lmstudio
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_API_KEY=lm-studio
# LM_STUDIO_MODEL=your-model-id-from-lm-studio

# Optional: SerpAPI for Google Search (google_search tool)
SERPAPI_KEY=your_serpapi_key_here
