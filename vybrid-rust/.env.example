# Copy to ~/.vybrid/.env for all projects, or use /menu in Vybrid to save there.
# You can also use a local .env in a project directory (overrides ~/.vybrid/.env).

# Z.AI API Key (GLM Coding Plan — default model glm-5.1)
ZAI_API_KEY=your_api_key_here

# Optional: SerpAPI for Google Search (google_search tool)
SERPAPI_KEY=your_serpapi_key_here
